    <script>
        // Navigation Handler
        function switchView(viewId) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active-view'));
            document.getElementById('view-' + viewId).classList.add('active-view');
            
            document.querySelectorAll('.nav-links a').forEach(el => el.classList.remove('active'));
            const navEl = document.getElementById('nav-' + viewId);
            if(navEl) navEl.classList.add('active');
            
            window.scrollTo(0, 0);
            if(viewId === 'orders') renderOrdersTable();
        }

        // LocalStorage Orders Management
        function getOrders() {
            let orders = localStorage.getItem('turbowash_orders');
            if(!orders) {
                orders = [
                    { id: 1, name: 'سلطان القحطاني', service: 'غسيل شامل (40 ريال)', location: 'حي الياسمين', car: 'تويوتا كامري - أبيض', time: '17:00', status: 'done' },
                    { id: 2, name: 'فهد العتيبي', service: 'غسيل خارجي (20 ريال)', location: 'حي النرجس', car: 'هوندا أورد - أسود', time: '18:30', status: 'progress' }
                ];
                localStorage.setItem('turbowash_orders', JSON.stringify(orders));
            }
            return JSON.parse(orders);
        }

        function saveOrders(orders) {
            localStorage.setItem('turbowash_orders', JSON.stringify(orders));
        }

        function handleBooking(e) {
            e.preventDefault();
            const service = document.getElementById('b-service').value;
            const name = document.getElementById('b-name').value;
            const phone = document.getElementById('b-phone').value;
            const location = document.getElementById('b-location').value;
            const car = document.getElementById('b-car').value;
            const time = document.getElementById('b-time').value;

            const orders = getOrders();
            const newOrder = {
                id: Date.now(),
                name,
                service,
                location,
                car,
                time,
                status: 'pending'
            };
            orders.unshift(newOrder);
            saveOrders(orders);

            // Setup WhatsApp Link
            const waText = encodeURIComponent(`السلام عليكم، أرغب بتأكيد حجز غسيل سيارة:\nالاسم: ${name}\nالخدمة: ${service}\nالحي: ${location}\nالسيارة: ${car}\nالوقت: ${time}`);
            document.getElementById('whatsapp-link').href = `https://wa.me/966500079374?text=${waText}`;

            document.getElementById('booking-form').style.display = 'none';
            document.getElementById('booking-success').style.display = 'block';
        }

        function renderOrdersTable() {
            const orders = getOrders();
            const tbody = document.getElementById('orders-table-body');
            tbody.innerHTML = '';

            let total = orders.length;
            let done = orders.filter(o => o.status === 'done').length;
            let progress = orders.filter(o => o.status === 'progress').length;
            let pending = orders.filter(o => o.status === 'pending').length;

            document.getElementById('stat-total').innerText = total;
            document.getElementById('stat-done').innerText = done;
            document.getElementById('stat-progress').innerText = progress;
            document.getElementById('stat-pending').innerText = pending;

            orders.forEach(o => {
                let badgeClass = 'status-pending';
                let statusText = 'جديد';
                if(o.status === 'progress') { badgeClass = 'status-progress'; statusText = 'قيد التنفيذ'; }
                if(o.status === 'done') { badgeClass = 'status-done'; statusText = 'تم التسليم'; }

                tbody.innerHTML += `
                    <tr>
                        <td>${o.name}</td>
                        <td>${o.service}</td>
                        <td>${o.location}</td>
                        <td>${o.car}</td>
                        <td>${o.time}</td>
                        <td><span class="status-badge ${badgeClass}">${statusText}</span></td>
                        <td>
                            <button onclick="updateOrderStatus(${o.id}, 'progress')" class="btn btn-outline" style="padding: 3px 8px; font-size:11px;">بدء</button>
                            <button onclick="updateOrderStatus(${o.id}, 'done')" class="btn btn-gold" style="padding: 3px 8px; font-size:11px;">تم</button>
                        </td>
                    </tr>
                `;
            });
        }

        function updateOrderStatus(id, newStatus) {
            let orders = getOrders();
            orders = orders.map(o => o.id === id ? {...o, status: newStatus} : o);
            saveOrders(orders);
            renderOrdersTable();
        }

        // Fleet Toggle Status
        function toggleFleetStatus(num) {
            const el = document.getElementById(`fleet${num}-status`);
            if(el.innerText.includes('متاح')) {
                el.innerText = 'مشغول حالياً';
                el.className = 'status-badge status-pending';
            } else {
                el.innerText = 'متاح';
                el.className = 'status-badge status-done';
            }
        }

        // Rating System
        let currentRating = 0;
        function setRating(val) {
            currentRating = val;
            const stars = document.querySelectorAll('#star-container .star');
            stars.forEach((s, idx) => {
                s.innerText = idx < val ? '★' : '☆';
                s.style.color = idx < val ? 'var(--gold)' : 'inherit';
            });
        }

        function submitRating() {
            if(currentRating === 0) {
                alert('الرجاء اختيار التقييم بالنجوم أولاً.');
                return;
            }
            document.getElementById('rating-form-box').style.display = 'none';
            document.getElementById('rating-thanks').style.display = 'block';
        }

        // Chatbot Widget Logic
        function toggleChatbot() {
            const win = document.getElementById('chatbot-window');
            win.classList.toggle('open');
        }

        const botKnowledge = {
            'كم الأسعار؟': 'خارجي 20، داخلي 25، شامل 40، اشتراك شهري 80 ريال.',
            'وش الخدمات؟': 'خارجي، داخلي، شامل، اشتراك شهري، وتلميع بسيط.',
            'وش العروض؟': 'عرض الأسبوع: شامل بـ 35 بدل 40 ريال.',
            'كيف أحجز؟': 'عبر صفحة الحجز الرسمية بالموقع، أو أرسل على واتساب: +966500079374',
            'وين موقعكم؟': 'نخدم جميع أحياء الرياض متنقلين عبر دبابات مجهزة.',
            'أرسل الموقع': 'أرسل اللوكيشن على واتساب: https://wa.me/966500079374',
            'تواصل معنا': 'رقم التواصل الرسمي: +966 50 007 9374',
            'التقييم': 'يمكنك إرسال تقييمك من صفحة التقييم من 1 إلى 5 نجوم.',
            'أوقات العمل': 'من 4 العصر إلى 11 الليل طوال أيام الأسبوع.',
            'الاشتراك الشهري': '4 غسلات شاملة بـ 80 ريال.'
        };

        function sendQuickChat(question) {
            const container = document.getElementById('chat-messages');
            
            // User message
            container.innerHTML += `<div class="message user">${question}</div>`;
            
            // Bot response
            setTimeout(() => {
                const answer = botKnowledge[question] || 'عذراً، يمكنك التواصل معنا مباشرة عبر واتساب للمساعدة.';
                container.innerHTML += `<div class="message bot">${answer}</div>`;
                container.scrollTop = container.scrollHeight;
            }, 300);

            container.scrollTop = container.scrollHeight;
        }

        // Initialize orders on load
        getOrders();
    </script>
</body>
</html>
